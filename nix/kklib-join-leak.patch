commit bb9e2fbad7f19a000cf7f21a2da3a419fb1f1084
Author: cognivore <66186054+cognivore@users.noreply.github.com>
Date:   Fri Jun 26 23:37:31 2026 +0100

    kklib: fix element refcount leak in kk_bytes_join_with
    
    Read elements through the borrowed buffer instead of kk_vector_at_borrow,
    which dup's each element into an owned box that the join loop never
    dropped -- leaking every joined string. kk_vector_drop(v) frees them, as
    in kk_string_from_chars.
    
    Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>

diff --git a/src/bytes.c b/src/bytes.c
index 282aa932..fb242cc7 100644
--- a/src/bytes.c
+++ b/src/bytes.c
@@ -427,13 +427,14 @@ kk_bytes_t  kk_bytes_join_with(kk_vector_t v, kk_bytes_t sep, kk_context_t* ctx)
   kk_ssize_t  copied = 0;
   kk_ssize_t  seplen;
   const char* sepbuf = kk_bytes_cbuf_borrow(sep, &seplen, ctx); 
-  kk_ssize_t  n = kk_vector_len_borrow(v, ctx);
+  kk_ssize_t  n;
+  kk_box_t*   vbuf = kk_vector_buf_borrow(v, &n, ctx);
   if (n <= 0) goto end;
 
   // find total required length
   // TODO: check totallen overflow
   for (kk_ssize_t i = 0; i < n; i++) {
-    kk_bytes_t elem = kk_bytes_unbox(kk_vector_at_borrow(v, i, ctx));
+    kk_bytes_t elem = kk_bytes_unbox(vbuf[i]);
     totallen += kk_bytes_len_borrow(elem, ctx);
   }
   totallen += (n - 1) * kk_bytes_len_borrow(sep, ctx);
@@ -442,7 +443,7 @@ kk_bytes_t  kk_bytes_join_with(kk_vector_t v, kk_bytes_t sep, kk_context_t* ctx)
   char* resbuf;
   res = kk_bytes_alloc_cbuf(totallen, &resbuf, ctx);
   for (kk_ssize_t i = 0; i < n; i++) {
-    kk_bytes_t elem = kk_bytes_unbox(kk_vector_at_borrow(v, i, ctx));
+    kk_bytes_t elem = kk_bytes_unbox(vbuf[i]);
     kk_ssize_t len;
     const char* cbuf = kk_bytes_cbuf_borrow(elem, &len, ctx);
     kk_memcpy(resbuf + copied, cbuf, len);
